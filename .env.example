# Скопируй этот файл в .env (он в .gitignore) и подставь свои значения.
# Оба compose-файла читают .env автоматически.

# Секрет подписи токенов. Обязателен: со случайным секретом токены игроков
# перестают работать после каждого перезапуска сервера.
STARKFLOW_SECRET=change-me-to-a-long-random-string

# Домен и почта для Caddy (вариант --profile caddy в docker-compose.tls.yml).
# A-запись домена должна указывать на IP этого сервера, порты 80 и 443 открыты.
SF_DOMAIN=game.example.com

# Токен туннеля Cloudflare (вариант --profile cfdomain), если порты открывать нельзя.
# CF_TUNNEL_TOKEN=eyJhIjoi...

# Необязательно: список разрешённых Origin через запятую вместо «разрешено всё».
# STARKFLOW_ORIGINS=https://game.example.com

# Необязательно: максимальная длина названия комнаты в символах.
# STARKFLOW_ROOM_NAME_MAX=32

# Необязательно: батчинг. state.changed/player.props/ok копятся для каждого
# игрока и уходят одним WS-кадром раз в столько миллисекунд. 0 — выключить
# (кадр на каждое изменение, удобно при отладке).
# STARKFLOW_BATCH_MS=40

# Необязательно: лимиты. Подними, если видишь ошибки "too many player
# properties" или "string is too long" (много синкаемых объектов на игрока).
# STARKFLOW_MAX_PLAYER_PROPS=24
# STARKFLOW_MAX_STRING_BYTES=4096
# ВНИМАНИЕ: MAX_MSG_BYTES — это лимит кадра, который сервер принимает. Плагин
# узнаёт его из welcome (maxMsg) и держит свои батчи ниже, поэтому менять можно,
# но не ниже ~2 КБ (иначе один батч перестанет влезать и соединение будет рваться).
# STARKFLOW_MAX_MSG_BYTES=65536
# STARKFLOW_MAX_SYNC_BYTES=32768   # размер одного снимка объектов (канал sync)
# Бюджет канала sync в байтах в секунду на игрока (снимок уходит всем остальным).
# 0 — без ограничения. Подними, если в логе видишь "sync: too many bytes per second".
# STARKFLOW_SYNC_BYTES_PER_SEC=524288

# --- Кластер: несколько нод + directory (опционально) ---
# Один образ, два бота. Роль бота задаётся ТОЛЬКО переменной окружения, команду
# запуска менять не нужно (важно для Bothost: аргументы в контейнер не доходят).
#   STARKFLOW_MODE=node      — игровой сервер (по умолчанию)
#   STARKFLOW_MODE=directory — распределитель: /assign, heartbeat от нод,
#                              админ-панель /admin/ (слушает тот же PORT)
#
# STARKFLOW_MODE=directory                          # бот-распределитель
#
# STARKFLOW_DIRECTORY_URL=https://dir.example.com   # нода: куда слать heartbeat
# STARKFLOW_PUBLIC_URL=wss://node1.example.com/ws   # нода: свой публичный адрес
# STARKFLOW_REGION=eu                               # нода: регион для роутинга
#                                                   # (eu / ru / ... — по ноде на регион;
#                                                   #  клиент сам замерит, кто ближе)
# STARKFLOW_CLUSTER_SECRET=shared-long-random-key   # общий секрет нод и directory
# STARKFLOW_ADMIN_TOKEN=another-long-random-key     # вход в админ-панель directory
#
# STARKFLOW_ORIGINS действует и на directory: /assign и /regions вызываются из браузера,
# поэтому без списка они открыты любому Origin, со списком — только этим.

# --- WebRTC-канал для sync (опционально) ---
# Снимки объектов идут по UDP (DataChannel без повторов и без очереди), а не по
# TCP-вебсокету: потерянный пакет просто пропускается и не тормозит следующие.
# Всё остальное остаётся на WebSocket. Не задан порт — WebRTC выключен, клиенты
# работают как раньше. Если UDP до сервера не доходит, клиент через 3 с сам
# остаётся на WebSocket.
# STARKFLOW_RTC_PORT=40000           # один UDP-порт на всех клиентов, открыть в фаерволе
# STARKFLOW_RTC_PUBLIC_IP=1.2.3.4    # внешний IP сервера: обязателен в Docker и за NAT
#                                    # (через запятую, если их несколько)
# STARKFLOW_RTC_ICE=stun:stun.l.google.com:19302   # STUN для клиентов (через запятую);
#                                                  # none — не давать никакого
