# Скопируй этот файл в .env (он в .gitignore) и подставь свои значения.
# Оба compose-файла читают .env автоматически.

# Секрет подписи токенов. Обязателен: со случайным секретом токены игроков
# перестают работать после каждого перезапуска сервера.
STARKFLOW_SECRET=change-me-to-a-long-random-string

# Домен и почта для Caddy (вариант --profile caddy в docker-compose.tls.yml).
# A-запись домена должна указывать на IP этого сервера, порты 80 и 443 открыты.
SF_DOMAIN=game.example.com

# Токен туннеля Cloudflare (вариант --profile cfdomain), если порты открывать нельзя.
# CF_TUNNEL_TOKEN=eyJhIjoi...

# Необязательно: список разрешённых Origin через запятую вместо «разрешено всё».
# STARKFLOW_ORIGINS=https://game.example.com

# Необязательно: максимальная длина названия комнаты в символах.
# STARKFLOW_ROOM_NAME_MAX=32
